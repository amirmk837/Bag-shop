generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              Int      @id @default(autoincrement())
  productCode     String   @unique
  title           String
  brand           String
  count           Int      @default(0)
  color           String?
  price           Int
  discountedPrice Int?
  description     String?
  images          String[]

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  colorStocks     ProductColorStock[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  productComments ProductComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductColorStock {
  id        Int    @id @default(autoincrement())
  productId Int
  color     String
  count     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, color])
  @@index([productId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  image     String?
  parentId  Int?
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]

  @@index([parentId, sortOrder])
}

enum UserRole {
  USER
  ADMIN
}

enum UserPermission {
  MANAGE_PRODUCTS
  MANAGE_CATEGORIES
  VIEW_ORDERS
  MANAGE_ORDERS
  MANAGE_USERS
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  phone        String?  @unique
  passwordHash String
  tokenVersion Int      @default(0)
  role         UserRole @default(USER)

  permissions UserPermission[]
  auditLogs   AdminAuditLog[]

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  cart    Cart?
  orders  Order[]
  address UserAddress?

  archivedOrders                Order[]                @relation("OrderArchivedBy")
  returnedOrderItems            OrderItem[]            @relation("OrderItemInventoryReturnedBy")
  createdInventoryReturnIssues  InventoryReturnIssue[] @relation("InventoryIssueCreatedBy")
  resolvedInventoryReturnIssues InventoryReturnIssue[] @relation("InventoryIssueResolvedBy")

  siteVisitEvents        SiteVisitEvent[]
  productComments        ProductComment[]
  repliedProductComments ProductComment[] @relation("ProductCommentReplier")
  supportTickets         SupportTicket[]
  supportMessages        SupportMessage[] @relation("SupportMessageAuthor")

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model UserAddress {
  id     Int @id @default(autoincrement())
  userId Int @unique

  recipientName  String
  recipientPhone String

  province String
  city     String

  addressLine String
  postalCode  String

  plateNumber String?
  unitNumber  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        Int    @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  color     String @default("")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, color])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryReturnStatus {
  NOT_RETURNED
  RETURNED
  NEEDS_REVIEW
}

enum InventoryReturnIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Order {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  status          OrderStatus @default(PENDING)
  totalAmount     Int
  stockReleasedAt DateTime?
  confirmedAt     DateTime?

  shippingRecipientName  String?
  shippingRecipientPhone String?
  shippingProvince       String?
  shippingCity           String?
  shippingAddressLine    String?
  shippingPostalCode     String?
  shippingPlateNumber    String?
  shippingUnitNumber     String?

  shippingCost     Int             @default(0)
  shippingMethod   String?
  trackingCode     String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  shippingMethodId Int?
  shippingOption   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  items                 OrderItem[]
  payments              Payment[]
  inventoryReturnIssues InventoryReturnIssue[]

  archivedAt    DateTime?
  archivedById  Int?
  archiveReason String?
  archivedBy    User?     @relation("OrderArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([archivedAt, createdAt])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productCode String
  title       String
  color       String @default("")
  unitPrice   Int
  quantity    Int
  subtotal    Int

  inventoryReturnStatus   InventoryReturnStatus @default(NOT_RETURNED)
  inventoryReturnedAt     DateTime?
  inventoryReturnedById   Int?
  inventoryReturnReceived Boolean               @default(false)
  inventoryReturnSaleable Boolean               @default(false)

  inventoryReturnedBy   User?                  @relation("OrderItemInventoryReturnedBy", fields: [inventoryReturnedById], references: [id], onDelete: SetNull)
  inventoryReturnIssues InventoryReturnIssue[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model InventoryReturnIssue {
  id Int @id @default(autoincrement())

  orderId     Int
  orderItemId Int?

  productCode String
  title       String
  color       String @default("")
  quantity    Int

  reason String
  status InventoryReturnIssueStatus @default(OPEN)

  resolutionNote String?
  resolvedAt     DateTime?

  createdById  Int?
  resolvedById Int?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdBy  User? @relation("InventoryIssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("InventoryIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([orderItemId])
}

model Banner {
  id              Int      @id @default(autoincrement())
  name            String
  imageUrl        String
  desktopImageUrl String?
  mobileImageUrl  String?
  linkUrl         String?
  fit             String   @default("contain")
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, updatedAt])
}

model SocialLink {
  id          Int      @id @default(autoincrement())
  platform    String   @unique
  label       String
  url         String?
  channelName String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model PaymentSettings {
  id         Int      @id @default(1)
  provider   String   @default("ZARINPAL")
  merchantId String?
  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum PaymentStatus {
  CREATED
  REQUESTING
  REQUESTED
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  provider String        @default("ZARINPAL")
  status   PaymentStatus @default(CREATED)

  // مبلغی که برای این تراکنش به درگاه ارسال می‌شود، به ریال
  amountRial Int

  // شناسه پیگیری دریافتی از زرین‌پال
  authority String? @unique
  refId     String? @unique

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchantIdSnapshot String?

  @@index([orderId, status])
}

model ShippingMethod {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  price       Int     @default(0)
  description String?
  isActive    Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum AdminAuditAction {
  ORDER_ARCHIVED
  ORDER_RESTORED
  ORDER_INVENTORY_RETURNED
  ORDER_INVENTORY_RETURN_ISSUE_CREATED
  ORDER_INVENTORY_RETURN_ISSUE_RESOLVED
  PAYMENT_RECONCILIATION
  PAYMENT_EXPIRED_UNSENT
  ORDER_STATUS_CHANGED
  ORDER_SHIPPING_UPDATED
  ORDER_DELETED
  ADMIN_LOGIN_FAILED
  USER_UPDATED
  USER_SOFT_DELETED
  USER_DELETED
}

model AdminAuditLog {
  id         Int              @id @default(autoincrement())
  adminId    Int?
  admin      User?            @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     AdminAuditAction
  targetType String
  targetId   Int
  orderId    Int?
  details    Json?
  createdAt  DateTime         @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([orderId, createdAt])
}

model SiteSettings {
  id                   Int     @id @default(1)
  storeName            String  @default("فروشگاه کاظمی")
  logoUrl              String?
  footerLogoUrl        String?
  phone                String?
  headerText           String?
  footerAbout          String?
  footerCaption        String?
  showPopularShowcase  Boolean @default(true)
  showDiscountShowcase Boolean @default(true)
  supportHours         Json?
  supportResponseText  String? @db.VarChar(240)

  updatedAt DateTime @updatedAt
}

model SiteVisitEvent {
  id              BigInt   @id @default(autoincrement())
  visitorId       String
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path            String   @db.VarChar(180)
  referrerHost    String?  @db.VarChar(255)
  deviceType      String   @db.VarChar(24)
  operatingSystem String   @db.VarChar(40)
  browser         String   @db.VarChar(40)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([referrerHost, createdAt])
}

enum ProductCommentType {
  COMMENT
  QUESTION
}

enum ProductCommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductComment {
  id          Int                  @id @default(autoincrement())
  productId   Int
  userId      Int
  type        ProductCommentType   @default(COMMENT)
  content     String
  status      ProductCommentStatus @default(PENDING)
  adminReply  String?
  repliedAt   DateTime?
  repliedById Int?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  repliedBy User?   @relation("ProductCommentReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum SupportTopic {
  ORDER
  PAYMENT
  PRODUCT
  SHIPPING
  ACCOUNT
  OTHER
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
}

enum SupportSenderRole {
  USER
  ADMIN
}

model SupportTicket {
  id              Int                 @id @default(autoincrement())
  userId          Int
  topic           SupportTopic
  status          SupportTicketStatus @default(NEW)
  customerName    String
  customerPhone   String?
  customerAddress String?
  lastMessageAt   DateTime            @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([status, createdAt])
}

model SupportMessage {
  id         Int               @id @default(autoincrement())
  ticketId   Int
  senderId   Int?
  senderRole SupportSenderRole
  content    String

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation("SupportMessageAuthor", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([senderId, createdAt])
}

model FooterTrustBadge {
  id        Int     @id @default(autoincrement())
  title     String  @db.VarChar(100)
  imageUrl  String  @db.VarChar(500)
  altText   String  @db.VarChar(180)
  linkUrl   String? @db.VarChar(2048)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder, id])
}
